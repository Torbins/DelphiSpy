package VclSpyInspectFmxNoPkg270;

{ Inspector for FireMonkey targets built with Delphi 10.4 without runtime
  packages, the fallback when the target loads no fmx270.bpl. A package
  without requires clause, so it contains the RTL itself, built as
  VclSpyInspectFmxNoPkg270.dll (see build.cmd and VclSpy.FmxNoPkg). It
  links no FMX unit: VclSpy.FmxInspector reaches the target's FMX objects
  through RTTI, which must be of the same Delphi version.
  VclSpy.MemoryManager must stay the first unit. }

{$IFNDEF VER340}
  {$MESSAGE FATAL 'VclSpyInspectFmxNoPkg270 must be built with Delphi 10.4.'}
{$ENDIF}

{$E dll}
{$RUNONLY}
{$IMPLICITBUILD ON}
{$DESCRIPTION 'VclSpy inspector for FireMonkey targets of Delphi 10.4 without runtime packages'}

contains
  VclSpy.MemoryManager in 'VclSpy.MemoryManager.pas',
  VclSpy.Protocol in '..\Common\VclSpy.Protocol.pas',
  VclSpy.Target in 'VclSpy.Target.pas',
  VclSpy.Properties in 'VclSpy.Properties.pas',
  VclSpy.Members in 'VclSpy.Members.pas',
  VclSpy.Report in 'VclSpy.Report.pas',
  VclSpy.FmxInspector in 'VclSpy.FmxInspector.pas',
  VclSpy.FmxNoPkg in 'VclSpy.FmxNoPkg.pas';

end.
