package VclSpyInspectNoPkg270;

{ Inspector for Delphi 10.4 targets built without runtime packages, the fallback
  when the target loads no vcl270.bpl. A package without requires clause, so
  it contains the RTL and VCL itself, built as VclSpyInspectNoPkg270.dll
  (see build.cmd and VclSpy.NoPkg). VclSpy.Target reaches the target's
  controls, which must be of the same Delphi version.
  VclSpy.MemoryManager must stay the first unit. }

{$IFNDEF VER340}
  {$MESSAGE FATAL 'VclSpyInspectNoPkg270 must be built with Delphi 10.4.'}
{$ENDIF}

{$E dll}
{$RUNONLY}
{$IMPLICITBUILD ON}
{$DESCRIPTION 'VclSpy inspector for Delphi 10.4 targets without runtime packages'}

contains
  VclSpy.MemoryManager in 'VclSpy.MemoryManager.pas',
  VclSpy.Protocol in '..\Common\VclSpy.Protocol.pas',
  VclSpy.Target in 'VclSpy.Target.pas',
  VclSpy.Properties in 'VclSpy.Properties.pas',
  VclSpy.Members in 'VclSpy.Members.pas',
  VclSpy.Report in 'VclSpy.Report.pas',
  VclSpy.VclProperties in 'VclSpy.VclProperties.pas',
  VclSpy.Inspector in 'VclSpy.Inspector.pas',
  VclSpy.SelfFinalize in 'VclSpy.SelfFinalize.pas',
  VclSpy.NoPkg in 'VclSpy.NoPkg.pas';

end.
